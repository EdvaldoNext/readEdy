# Copie para .env. A API fica na Cloudflare; o banco fica no Turso.
# Na Vercel: Settings → Environment Variables (mesmos nomes).

READEDY_API_URL=https://readedy-api.edvaldomil.workers.dev
READEDY_API_KEY=readedy-public

# Segredos do Worker (não vão para o browser).
# A URL do banco está em wrangler.jsonc. O token fica só no Worker.
# TURSO_AUTH_TOKEN=
# AUTH_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=
# READEDY_ADMIN_EMAILS=
# READEDY_APP_URL=https://readedy.vercel.app
