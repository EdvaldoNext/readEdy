# Copie para .env e preencha com os valores do seu projeto Supabase.
# Na Vercel: Settings → Environment Variables (mesmos nomes).

SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Edge Functions (Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_SERVICE_ROLE_KEY=   # apenas no Supabase, nunca no browser
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# READEDY_APP_URL=https://seu-dominio.vercel.app
